{
  "name": "wherewent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.prototype.config.ts",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "zip": "node scripts/zip.mjs",
    "package": "npm run build && npm run zip",
    "e2e": "xvfb-run -a node e2e/run.mjs",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "build:prototype": "vite build --config vite.prototype.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
